{
  "name": "qc-codeus",
  "version": "0.1.1",
  "description": "QC Codeus — Quantum Club's next-gen agentic development platform merged with IDE experiences.",
  "main": "./out/main/index.js",
  "author": "Quantum Club",
  "homepage": "https://github.com/atomicfield/qc-codeus",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "test": "bun test",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-vite build",
    "postinstall": "electron-builder install-app-deps && bun run scripts/fix-node-pty-perms.ts",
    "icons": "bun run scripts/build-icon.ts && bun run scripts/build-tray-icon.ts",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "bun run build && electron-builder --win --publish never",
    "build:mac": "cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-vite build && electron-builder --mac --publish never",
    "build:linux": "cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/onest": "^5.2.11",
    "@monaco-editor/react": "^4.7.0",
    "@vercel/sandbox": "^2.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-intl": "^4.12.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "figma-squircle": "^1.1.0",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
