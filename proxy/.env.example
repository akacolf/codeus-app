# QC's LLM Gateway key — preferred upstream for proxied generation requests.
LLM_GATEWAY_API_KEY=

# Optional Vercel AI Gateway fallback — useful while spending the free Vercel
# AI Gateway credits. Set QC_UPSTREAM_GATEWAY=vercel-ai-gateway to force this.
AI_GATEWAY_API_KEY=

# Upstream selector: auto (prefer LLM Gateway, fall back to Vercel), llm-gateway,
# or vercel-ai-gateway.
QC_UPSTREAM_GATEWAY=auto

# Mock mode: skip the upstream entirely and stream a canned OpenAI-format reply.
# Useful for testing the full pipeline without spending credits.
QC_MOCK_UPSTREAM=true

# Shared secret the desktop client sends as `Authorization: Bearer <token>`.
# Must match the constant baked into src/main/chat.ts (QC_CLIENT_TOKEN).
QC_CLIENT_TOKEN=
