# QC's Vercel AI Gateway key — proxied requests are billed to this key.
# Get one from the Vercel dashboard → AI Gateway. New orgs get $5 of free
# credits every 30 days; zero markup on tokens.
AI_GATEWAY_API_KEY=

# Mock mode: skip the upstream entirely and stream a canned OpenAI-format reply.
# Useful for testing the full pipeline without spending credits.
QC_MOCK_UPSTREAM=true
