# QC's OpenRouter key — proxied requests are billed to this key.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: OpenRouter analytics attribution.
OPENROUTER_REFERER=https://qccodium.com
OPENROUTER_TITLE=QC Codium

# Mock mode: skip OpenRouter entirely and stream a canned OpenAI-format reply.
# Useful for testing the full pipeline without spending credits.
QC_MOCK_UPSTREAM=true
